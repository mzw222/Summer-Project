from flask import Flask, request, jsonify
import sqlite3

app = Flask(__name__)

# 连接到SQLite数据库
def get_db_connection():
    conn = sqlite3.connect('北京景点数据.db')
    conn.row_factory = sqlite3.Row
    return conn

@app.route('/search_attractions', methods=['GET'])
def search_attractions():
    search_term = request.args.get('search_term', '')
    conn = get_db_connection()
    cursor = conn.cursor()
    # 执行SQL查询，按评论数降序排序并限制结果为10条
    query = f"SELECT 景区名称 FROM 景点数据表 WHERE 景区名称 LIKE '%{search_term}%' ORDER BY 评论数 DESC LIMIT 10"
    cursor.execute(query)
    results = cursor.fetchall()
    attraction_names = [dict(row)['景区名称'] for row in results]
    conn.close()
    return jsonify(attraction_names)

